{
  "name": "kubermeister",
  "version": "0.10.0",
  "description": "Desktop Kubernetes client",
  "private": true,
  "license": "MIT",
  "author": "Ararat Poghosyan",
  "homepage": "https://github.com/kubermeister/kubermeister#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubermeister/kubermeister.git"
  },
  "bugs": {
    "url": "https://github.com/kubermeister/kubermeister/issues"
  },
  "type": "module",
  "main": "./out/main/index.mjs",
  "engines": {
    "node": ">=24",
    "npm": ">=11.19"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && node scripts/enable-hooks.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/check-preload.mjs",
    "preview": "electron-vite preview",
    "package": "node scripts/check-electron-notices.mjs && electron-builder --config electron-builder.yml --publish never",
    "package:dir": "node scripts/check-electron-notices.mjs && electron-builder --config electron-builder.yml --publish never --dir",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.demo.config.ts",
    "screenshots:sync": "node scripts/sync-screenshots.mjs",
    "schema": "vitest run tests/unit/repo/settings-schema.test.ts --mode write"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "electron-updater": "^6.8.9",
    "js-yaml": "^5.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.17",
    "@tanstack/router-plugin": "^1.168.43",
    "@testcontainers/k3s": "^12.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.55.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
