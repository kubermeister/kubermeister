# Maintainer: Ararat Poghosyan <ararat.poghosyan@gmail.com>
#
# Template for kubermeister-bin on the AUR. The release workflow substitutes __VERSION__,
# __SHA256_X86_64__, __SHA256_AARCH64__ and __SHA256_LICENSE__, generates .SRCINFO from the result
# and pushes both to ssh://aur@aur.archlinux.org/kubermeister-bin.git on every stable release. The
# deb URLs depend on the artifactName pattern in electron-builder.yml.
#
# The package repackages the release's deb: its data.tar carries /opt/Kubermeister, the desktop
# entry and the icons. Extracting it skips the deb's postinst, so package() does what that script
# does. pacman's own hooks refresh the desktop and MIME databases.
pkgname=kubermeister-bin
pkgver=__VERSION__
pkgrel=1
pkgdesc='Desktop Kubernetes client'
arch=(x86_64 aarch64)
url='https://kubermeister.dev'
license=(MIT)
# libsecret is what safeStorage seals chart repository credentials through.
depends=(gtk3 nss alsa-lib libxss libnotify xdg-utils libsecret)
optdepends=('gnome-keyring: a secret service for stored chart repository credentials'
            'kwallet: a secret service for stored chart repository credentials')
provides=(kubermeister)
conflicts=(kubermeister)
options=(!strip !debug)
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/kubermeister/kubermeister/v${pkgver}/LICENSE")
source_x86_64=("${pkgname}-${pkgver}-x86_64.deb::https://github.com/kubermeister/kubermeister/releases/download/v${pkgver}/Kubermeister-${pkgver}-linux-amd64.deb")
source_aarch64=("${pkgname}-${pkgver}-aarch64.deb::https://github.com/kubermeister/kubermeister/releases/download/v${pkgver}/Kubermeister-${pkgver}-linux-arm64.deb")
sha256sums=('__SHA256_LICENSE__')
sha256sums_x86_64=('__SHA256_X86_64__')
sha256sums_aarch64=('__SHA256_AARCH64__')

package() {
    bsdtar -xf data.tar.* -C "$pkgdir"
    install -d "$pkgdir/usr/bin"
    ln -s /opt/Kubermeister/kubermeister "$pkgdir/usr/bin/kubermeister"
    # A kernel without unprivileged user namespaces (linux-hardened) needs the SUID sandbox.
    chmod 4755 "$pkgdir/opt/Kubermeister/chrome-sandbox"
    install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
